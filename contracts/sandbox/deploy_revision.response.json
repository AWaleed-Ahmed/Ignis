{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raphael.dev/contracts/sandbox/deploy_revision.response.json",
  "title": "DeployRevisionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["sandbox_id", "status", "rendered_artifact_ids", "fidelity", "deployed_at"],
  "properties": {
    "sandbox_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["deployed", "failed", "policy_blocked"]
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name"],
        "properties": {
          "kind": { "type": "string" },
          "name": { "type": "string" },
          "api_version": { "type": "string" }
        }
      }
    },
    "rendered_artifact_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "image_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "fidelity": { "$ref": "fidelity_report.json" },
    "tool_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Client tool versions used during deploy (helm/kubectl/kustomize)"
    },
    "message": { "type": "string" },
    "rendered_files": {
      "type": "array",
      "description": "Files actually rendered and applied for this deploy call. Bounded to the rendered output of this specific deploy; never a directory listing. Paths are relative to the workspace root. Added in contracts-v1.1.0; optional for backward compatibility.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    },
    "deployed_at": { "type": "string", "format": "date-time" }
  }
}
